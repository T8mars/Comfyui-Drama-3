{
  "1": {
    "class_type": "T8DramaLoader",
    "inputs": {
      "model": "drama3-t8-fp8.safetensors",
      "codec": "drama3-codec.safetensors",
      "expert_cache_gb": 12,
      "gdn_backend": "torch"
    }
  },
  "2": {
    "class_type": "LoadAudio",
    "inputs": {
      "audio": "reference.wav"
    }
  },
  "3": {
    "class_type": "T8DramaCodecEncode",
    "inputs": {
      "engine": [
        "1",
        0
      ],
      "audio": [
        "2",
        0
      ]
    }
  },
  "4": {
    "class_type": "T8DramaCodecDecode",
    "inputs": {
      "engine": [
        "1",
        0
      ],
      "codes": [
        "3",
        0
      ]
    }
  },
  "5": {
    "class_type": "SaveAudio",
    "inputs": {
      "audio": [
        "4",
        0
      ],
      "filename_prefix": "Drama3_T8/output"
    }
  }
}